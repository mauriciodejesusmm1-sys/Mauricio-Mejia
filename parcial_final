using System;

class Program
{
    static void Main()
    {
        string usuarioCorrecto = "soporteDB";
        string contraseñaCorrecta = "Sistemas2025";

        string usuario, contraseña;

        int intento = 0;
        bool conectado = false;

        do
        {
            Console.WriteLine("\n--- CONEXION A BASE DE DATOS ---");

            Console.Write("Ingrese el usuario: ");
            usuario = Console.ReadLine();

            Console.Write("Ingrese la contraseña: ");
            contraseña = Console.ReadLine();
            if (usuario == "admin")
            {
                Console.WriteLine("Servidor no disponible. Reintente más tarde.");
            }
            else
            {
                intento++;

                if (usuario == usuarioCorrecto &&
                    contraseña == contraseñaCorrecta)
                {
                    Console.WriteLine("Conexión establecida con la base de datos.");
                    conectado = true;
                }
                else
                {
                    Console.WriteLine("Error de autenticación. Intento "
                        + intento + " de 3.");
                }
            }

        } while (!conectado && intento < 3);

        if (!conectado)
        {
            Console.WriteLine("\nConexión bloqueada por seguridad.");
            Console.WriteLine("Comuníquese con el administrador del sistema.");
        }

        Console.ReadKey();
    }
}
